# Environment Variables

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=pit-feature-store-consumer
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false

# ClickHouse Configuration
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=secure_password_here
CLICKHOUSE_DATABASE=pit_features

# Flink Configuration
FLINK_CHECKPOINT_DIR=/var/flink/checkpoints
FLINK_SAVEPOINT_DIR=/var/flink/savepoints
FLINK_STATE_BACKEND=rocksdb
FLINK_PARALLELISM=4

# Prometheus Configuration
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090

# Security Configuration
ENCRYPTION_KEY=your-32-byte-aes-key-here
PII_TOKENIZATION_SECRET=your-tokenization-secret
AUDIT_LOG_PATH=/var/log/pit-audit.log

# Redis (for deduplication cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:8081

# Monitoring
GRAFANA_HOST=localhost
GRAFANA_PORT=3000

# Token Tracking (for LLM costs)
LLM_API_KEY=your-api-key
TOKEN_TRACKING_ENABLED=true
